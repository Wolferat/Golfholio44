{
  "name": "Review",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "photo_uri": {
      "type": "string",
      "description": "Private file URI from UploadPrivateFile \u2014 never an external URL. Signed URLs are created server-side for display."
    },
    "author_name": {
      "type": "string",
      "description": "Player display name at time of review"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "pending"
    },
    "moderation_note": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "rating",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}