{
  "name": "GolferProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "home_city": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "username",
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}