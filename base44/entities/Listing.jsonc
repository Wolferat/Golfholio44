{
  "name": "Listing",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "course",
        "simulator",
        "training",
        "tournament",
        "charity_event",
        "corporate_event",
        "league",
        "golf_related_venue"
      ],
      "default": "course"
    },
    "venue_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "price_note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number"
    },
    "place_id": {
      "type": "string"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_timezone": {
      "type": "string",
      "description": "IANA timezone identifier for the event's local time (e.g. America/Chicago). Used for accurate expiration calculation."
    },
    "registration_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Official registration deadline, when published by the organizer."
    },
    "individual_entry_fee": {
      "type": "number",
      "description": "Per-player entry fee when stated by the official source."
    },
    "team_entry_fee": {
      "type": "number",
      "description": "Per-team entry fee when stated by the official source."
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "ISO 4217 currency code for entry fees."
    },
    "fee_status": {
      "type": "string",
      "enum": [
        "known",
        "free",
        "variable",
        "unknown"
      ],
      "default": "unknown",
      "description": "Whether the entry fee is known, free, variable, or unknown."
    },
    "event_format": {
      "type": "string",
      "description": "Tournament format (e.g. stroke play, scramble, best ball) \u2014 only when stated by the source."
    },
    "team_size": {
      "type": "number",
      "description": "Team size (e.g. 2, 4) \u2014 only when stated by the source."
    },
    "eligibility": {
      "type": "string",
      "description": "Eligibility requirements (e.g. Open, Members, Amateur) \u2014 only when stated by the source."
    },
    "included_items": {
      "type": "string",
      "description": "What the entry fee includes (e.g. green fee, cart, lunch) \u2014 only when stated by the source."
    },
    "contact_email": {
      "type": "string",
      "description": "Organizer contact email \u2014 only if published by the official organizer."
    },
    "last_source_verification": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last source verification check for this event's details."
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "flagged",
        "rejected",
        "expired",
        "archived",
        "claimed"
      ],
      "default": "pending"
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "unclaimed",
        "pending_claim",
        "claimed"
      ],
      "default": "unclaimed"
    },
    "source_url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "google_places",
        "official_website",
        "event_website",
        "google_business_profile",
        "trusted_organization",
        "community_report",
        "admin"
      ],
      "default": "google_places"
    },
    "verification_tier": {
      "type": "number"
    },
    "verification_notes": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "official_website": {
      "type": "string"
    },
    "official_registration_url": {
      "type": "string"
    },
    "is_professional_tournament": {
      "type": "boolean",
      "default": false
    },
    "claimed_by": {
      "type": "string"
    },
    "photo_source": {
      "type": "string"
    },
    "photo_verified": {
      "type": "boolean",
      "default": false
    },
    "photo_source_url": {
      "type": "string"
    },
    "golf_verified": {
      "type": "boolean",
      "default": false
    },
    "golf_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "golf_verified_by": {
      "type": "string"
    },
    "ingestion_source": {
      "type": "string"
    },
    "ingestion_job_id": {
      "type": "string"
    },
    "source_urls_considered": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}