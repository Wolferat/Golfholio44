{
  "name": "Listing",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "course",
        "simulator",
        "training",
        "tournament",
        "charity_event",
        "corporate_event",
        "league",
        "golf_related_venue"
      ],
      "default": "course"
    },
    "venue_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "price_note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number"
    },
    "place_id": {
      "type": "string"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "flagged",
        "rejected",
        "expired",
        "archived",
        "claimed"
      ],
      "default": "pending"
    },
    "source_url": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "google_places",
        "official_website",
        "event_website",
        "google_business_profile",
        "trusted_organization",
        "community_report",
        "admin"
      ],
      "default": "google_places"
    },
    "verification_tier": {
      "type": "number"
    },
    "verification_notes": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by": {
      "type": "string"
    },
    "official_website": {
      "type": "string"
    },
    "official_registration_url": {
      "type": "string"
    },
    "is_professional_tournament": {
      "type": "boolean",
      "default": false
    },
    "claimed_by": {
      "type": "string"
    },
    "photo_source": {
      "type": "string"
    },
    "photo_verified": {
      "type": "boolean",
      "default": false
    },
    "photo_source_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}